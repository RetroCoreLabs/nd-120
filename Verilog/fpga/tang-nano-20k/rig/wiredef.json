  "meta": {
    "title": "Pico <-> Tang Nano 20K - ND-bus rig wiring",
    "authoritative_source": "NDModulE/docs/design/nd120_tang20k_rig.cst + nd_bus_pins.h",
    "wire_count": 31,
    "voltage": "3.3V LVCMOS33, no level shifters",
    "directions": "dir is from the FPGA(Tang) view: OUT=Tang drives->Pico samples; IN=Pico drives->Tang samples; BIDIR=shared data bus",
    "notes": "Interrupts are latched over DBUS via LE_INT (no dedicated BINT pins). Daisy OE not wired.",
    "pin_overlap": "Tang balls 15-20 are the CPU's led[0-5] (repurposed by the bus HAL); balls 80-85 are the CPU SD card (kept free); 'HSPI' silk pins carry no PSRAM (CPU memory is on-package SDRAM). See per-pin notes."
  },
