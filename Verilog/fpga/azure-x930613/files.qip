# File list for the Azure card (X930613-001) build.
#
# Read by nd120_azure.qsf (Quartus) AND by sim/vtest.sh (Verilator), so the
# simulated machine and the built one are the same Verilog.
#
# The shared CPU/board part is the MiSTer core's list (fpga/mister/files.qip)
# with the MiSTer-only files left out: its framework (sys/), its video
# console, PLL, debug probes and top. Paths are relative to this folder.
# When a shared file is added to or removed from the MiSTer list, change
# this list the same way.

# --- this board ---------------------------------------------------------------
set_global_assignment -name VERILOG_FILE rtl/nd120_azure_top.v
set_global_assignment -name VERILOG_FILE rtl/pcie_hip_wrap.v
set_global_assignment -name VERILOG_FILE rtl/pcie_bar_bus.v
set_global_assignment -name VERILOG_FILE rtl/nd_pcie_console.v
set_global_assignment -name VERILOG_FILE rtl/nd_pcie_storage.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/console_uart_rx.v
set_global_assignment -name VERILOG_FILE ../../Terminals/rtl/console_uart_tx.v

# --- shared with the MiSTer core -------------------------------------------
