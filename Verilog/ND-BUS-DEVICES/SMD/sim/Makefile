# Unit testbench for the ND-100 SMD disk controller
# (repo convention: sim/ next to the modules it tests)
#
# test / test-smd - the full DMA device stack: CWR-multiplexed register
#   file, M0/M1 transfers through ND_DMA_MASTER against the BCU+memory
#   model, seek/on-cylinder, interrupt + IDENT 017

# Shared include paths (Verilog/mk/iverilog.mk). Provides $(ND_INC),
# which covers SD-FAT/circuit - the controllers include
# nd_storage_status.vh from there.
VERILOG_ROOT = ../../..
include $(VERILOG_ROOT)/mk/iverilog.mk


SRCS = ../../BUS-IF/circuit/ND_BUS_SLAVE.v \
       ../../DMA/circuit/ND_DMA_MASTER.v \
       ../circuit/ND_SMD.v \
       nd_smd_tb.v

# test-smd-iox: the IOX register / status / control-word conformance matrix
#   asserted directly at the device IOX slave port (no BUS_SLAVE, no GO/DMA):
#   boot-mode exit, CWR multiplexing, the 15 MHz memory address / word count
#   flip-flop (first write loads all 24 bits, shared toggle, resets),
#   15 MHz seek-id bit, level-sensitive interrupt + IDENT 017, device clear.
IOX_SRCS = ../circuit/ND_SMD.v \
           nd_smd_iox_tb.v

# test-smd-p2: the 15 MHz read-flip-flop machinery (s_ma_wc_ff toggle,
#   status-read clr_ff) proven against the REAL single-cycle iox_rd strobe
#   generated by ND_BUS_SLAVE - driven through the CPU-side bus handshake.
#   No GO/DMA (engine stays E_IDLE); the DMA + disk backend are tied idle.
P2_SRCS = ../../BUS-IF/circuit/ND_BUS_SLAVE.v \
          ../circuit/ND_SMD.v \
          nd_smd_p2_tb.v

# test-smd-ecc: the ECC / single-write (NO flip-flop) register model, i.e.
#   ND_SMD strapped HAS_WC_FLIPFLOP=0. Proves each of Core Address /
#   Word Counter / ECC Control loads in ONE write and reads back stably, and
#   the mass-storage boot primitive (a single +7 write of 002000 -> 1024).
ECC_SRCS = ../circuit/ND_SMD.v \
           nd_smd_ecc_tb.v

# test-smd-err: the ILLEGAL / ERROR paths - what the controller does when the
#   guest misbehaves. Every other bench drives only legal sequences, so the
#   missing illegal-load checks on +7 and +5 (and +5 blocking device clear
#   while active) sat undetected with all gates green. Issues a real GO (M6
#   seek complete search with no seek given, no disk backend) that stays
#   active until its timeout, with a small CLK_HZ so that is short, while the
#   illegal writes are made. Also the off-cylinder illegal load after an M4,
#   the drive's arrival, and the M6 timeout.
ERR_SRCS = ../circuit/ND_SMD.v \
           nd_smd_err_tb.v

# test-smd-timing: the real drive timing (FAST = 0) against nd100x's own
#   formulas - the drives' seeks (M4, M7), transfers with and without a
#   seek, Write Format, a test-mode transfer, and the Seek Complete Search
#   (M6) with and without a seek given.
TIMING_SRCS = ../circuit/ND_SMD.v \
              nd_smd_timing_tb.v

# test-smd-ops: the operations the other benches do not reach, against
#   nd100x - ECC control in one write, test-mode M0 / M3, Write Format (M5)
#   field reads and its timeout and mismatch ends, M1 with a failed memory
#   read, M8, M9, codes 10-15, and a GO on a not-specified unit.
OPS_SRCS = ../circuit/ND_SMD.v \
           nd_smd_ops_tb.v

all: test

test: test-smd test-smd-iox test-smd-p2 test-smd-ecc test-smd-err test-smd-timing test-smd-ops

nd_smd_tb.vvp: $(SRCS)
	$(IVERILOG) -g2005 $(ND_INC) -o $@ $(SRCS)

test-smd: nd_smd_tb.vvp
	$(VVP) nd_smd_tb.vvp | tee smd_out.log
	@grep -q "TB_RESULT: PASS" smd_out.log

nd_smd_iox_tb.vvp: $(IOX_SRCS)
	$(IVERILOG) -g2005 $(ND_INC) -o $@ $(IOX_SRCS)

test-smd-iox: nd_smd_iox_tb.vvp
	$(VVP) nd_smd_iox_tb.vvp | tee smd_iox_out.log
	@grep -q "TB_RESULT: PASS" smd_iox_out.log

nd_smd_p2_tb.vvp: $(P2_SRCS)
	$(IVERILOG) -g2005 $(ND_INC) -o $@ $(P2_SRCS)

test-smd-p2: nd_smd_p2_tb.vvp
	$(VVP) nd_smd_p2_tb.vvp | tee smd_p2_out.log
	@grep -q "TB_RESULT: PASS" smd_p2_out.log

nd_smd_ecc_tb.vvp: $(ECC_SRCS)
	$(IVERILOG) -g2005 $(ND_INC) -o $@ $(ECC_SRCS)

test-smd-ecc: nd_smd_ecc_tb.vvp
	$(VVP) nd_smd_ecc_tb.vvp | tee smd_ecc_out.log
	@grep -q "TB_RESULT: PASS" smd_ecc_out.log

nd_smd_err_tb.vvp: $(ERR_SRCS)
	$(IVERILOG) -g2005 $(ND_INC) -o $@ $(ERR_SRCS)

test-smd-err: nd_smd_err_tb.vvp
	$(VVP) nd_smd_err_tb.vvp | tee smd_err_out.log
	@grep -q "TB_RESULT: PASS" smd_err_out.log

nd_smd_timing_tb.vvp: $(TIMING_SRCS)
	$(IVERILOG) -g2005 $(ND_INC) -o $@ $(TIMING_SRCS)

test-smd-timing: nd_smd_timing_tb.vvp
	$(VVP) nd_smd_timing_tb.vvp | tee smd_timing_out.log
	@grep -q "TB_RESULT: PASS" smd_timing_out.log

nd_smd_ops_tb.vvp: $(OPS_SRCS)
	$(IVERILOG) -g2005 $(ND_INC) -o $@ $(OPS_SRCS)

test-smd-ops: nd_smd_ops_tb.vvp
	$(VVP) nd_smd_ops_tb.vvp | tee smd_ops_out.log
	@grep -q "TB_RESULT: PASS" smd_ops_out.log

clean:
	rm -f *.vvp *.log *.vcd

.PHONY: all test test-smd test-smd-iox test-smd-p2 test-smd-ecc test-smd-err test-smd-timing test-smd-ops clean
